# Exemplo de variáveis de ambiente do backend.
# Copie para .env e preencha com valores reais (NUNCA commite o .env).
# Em produção, prefira definir estas variáveis no painel do host.

# Credenciais AWS (IAM com menor privilégio: s3:PutObject e s3:GetObject no bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# String de conexão do MongoDB (mongodb:// ou mongodb+srv://)
MONGODB_URI=

# CORS: origens permitidas separadas por vírgula (sem barra final).
# Ex.: https://meu-front.vercel.app,http://localhost:5173
# Vazio = nenhuma origem de browser permitida.
CORS_ORIGINS=
